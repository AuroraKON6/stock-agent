# R08 candidate image (NOT YET BUILT — docker engine unreachable from the
# authoring session; digests below were fetched from the Docker Hub registry
# API on 2026-10-22 and MUST be re-verified at the first controlled build).
#
# Build contract (GLM_REFACTOR_TASKBOOK R08):
#   1. Both base images are pinned by sha256 digest — a floating tag is a
#      build blocker (A39 stop condition: no floating latest).
#   2. Builder stages: Linux venv from requirements.linux-py312.lock.txt
#      (pip --require-hashes --no-deps) and Pi node_modules from
#      package-lock.json (npm ci). NOTHING installs at runtime (A38).
#   3. PROVENANCE.json is generated by the build wrapper (scripts/build_image.sh)
#      from the build context (commit/dirty/tree/lock hashes) and shipped
#      read-only. The image digest is bound EXTERNALLY after the build via
#      stock_agent.release_provenance.write_image_binding — writing it into
#      the image would change the digest (recursive trap).
#   4. Non-root user, five explicit APP_* roots (runtime_layout), healthcheck
#      that performs no network / model / business writes.

ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
ARG NODE_IMAGE=node:22-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d

# ---- stage 1: python dependency wheelhouse -> venv (from the frozen lock) ----
FROM ${PYTHON_IMAGE} AS python-builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements.linux-py312.lock.txt ./requirements.linux-py312.lock.txt
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-deps --require-hashes \
        -r requirements.linux-py312.lock.txt

# ---- stage 2: pi node_modules from the frozen npm lock -----------------------
FROM ${NODE_IMAGE} AS pi-builder
WORKDIR /pi
COPY pi_runtime/package.json pi_runtime/package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev

# ---- runtime: node base (Pi subprocess) + python overlay + baked venv --------
FROM ${NODE_IMAGE}
# python:3.12-slim and node:22-slim share the Debian bookworm userland, so
# overlaying the python image's /usr/local (interpreter + stdlib) is a
# self-consistent runtime.
COPY --from=python-builder /usr/local /usr/local
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_CONFIG_ROOT=/app/config \
    APP_STATE_ROOT=/var/stock-agent/state \
    APP_EVIDENCE_ROOT=/var/stock-agent/evidence \
    APP_REPORT_ROOT=/var/stock-agent/reports \
    APP_TEMP_ROOT=/tmp/stock-agent
WORKDIR /app
# Application source only — .dockerignore strips .git, host venvs, local
# configs, secrets, data/, reports/, logs/ (A37 stop conditions). The
# PROVENANCE.json file is generated by the build wrapper into the context
# root before `docker build`, so the optional COPY lands it in /app.
COPY stock_agent ./stock_agent
COPY requirements.linux-py312.lock.txt ./
COPY PROVENANCE.json* ./
COPY --from=python-builder /opt/venv /opt/venv
COPY --from=pi-builder /pi/node_modules /app/pi_runtime/node_modules
COPY pi_runtime/package.json pi_runtime/package-lock.json /app/pi_runtime/
RUN groupadd --system app \
    && useradd --system --gid app --home /app app \
    && mkdir -p /var/stock-agent/state /var/stock-agent/evidence \
                /var/stock-agent/reports /tmp/stock-agent /app/config \
    && chown -R app:app /var/stock-agent /tmp/stock-agent /app
USER app
# The image carries no .git: release identity is the PROVENANCE chain —
# verified read-only via stock_agent.release_provenance (BLOCKED without the
# external digest binding; never auto-passed).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import stock_agent, stock_agent.runtime_layout; stock_agent.runtime_layout.resolve_layout()"]
CMD ["python", "-m", "stock_agent", "--help"]
