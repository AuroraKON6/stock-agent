# stock-agent 本机凭据模板（只有占位符，不要在此文件填写真实值）。
# stock-agent local credential template. PLACEHOLDERS ONLY -- never put a real
# key in this file: it is tracked by Git.
#
# 用法 / Usage:
#   cp .env.example .env.local     # .env.local is gitignored (.env.*)
#   然后只在本机编辑 .env.local。Python CLI 启动时由
#   stock_agent.config.load_local_secrets() 读取 .env.local 并注入环境变量；
#   文件中的值优先于 shell 里继承的同名变量。
#
#   The Python CLI loads .env.local into the environment on start-up and the
#   file wins over an inherited shell value. Commands that do not go through
#   the CLI entry point (for example plain `python -m unittest`) read the real
#   environment only, so export the variable in the shell for those.
#
# Alternative injection: export the variable in the launching shell, or keep it
# in the macOS Keychain and load it with `security find-generic-password -w -s
# <service> -a <account>` into the environment of the launching shell.
# 不需要外部模型时，全部留空即可：示例配置 config/watchlist.example.json
# 关闭了 LLM 与所有行情源，离线即可跑通主流程。

# ---- LLM（不填则跳过 LLM 增强，流程照常完成）--------------------------------
# DeepSeek 主模型（config 的 llm_agent.providers[].api_key_env）
DEEPSEEK_API_KEY=
# 通用回退名称
LLM_API_KEY=
# 可选覆盖：模型名 / 接口地址（留空使用 config 里的值）
LLM_MODEL=
LLM_BASE_URL=
# 可选回退供应商（config 的 providers 中 base_url_env / model_env / api_key_env）
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# ---- 行情数据源令牌（对应 config sources.*.token_env，未启用可留空）----------
XUEQIU_TOKEN=
ALLTICK_TOKEN=
FREE_QUOTE_TOKEN=

# ---- Pi Agent 运行时 --------------------------------------------------------
# 可选：显式指定 Pi 可执行文件；留空则使用 pi_runtime/node_modules 中锁定版本
PI_AGENT_BINARY=

# ---- Docker Compose（Dify 回放环境，见 deploy/dify/compose.example.env）----
# Docker Compose 不会读取本文件；Dify 环境使用 deploy/dify/compose.example.env
# 的占位符另存为未跟踪的本地 env 文件再通过 --env-file 传入。
