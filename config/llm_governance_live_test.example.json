      "fully_grounded_rate_min": 0.75,
      "usage_metadata_rate_min": 1.0
    },
    "pricing": {
      "enabled": true,
      "currency": "USD",
      "effective_date": "2026-08-12",
      "source_url": "https://api-docs.deepseek.com/quick_start/pricing",
      "models": {
        "deepseek-v4-pro": {
          "input_cache_hit_per_1m": 0.003625,
          "input_cache_miss_per_1m": 0.435,
          "output_per_1m": 0.87
        }
      }
    }
  },
  "llm_agent": {
    "enabled": true,
