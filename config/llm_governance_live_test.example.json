    ]
  },
  "multi_role_agent": {
    "enabled": true,
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-v4-pro",
    "timeout": 60,
    "temperature": 0.1,
    "json_mode": true,
    "thinking": "enabled",
